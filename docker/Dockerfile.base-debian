# syntax=docker/dockerfile:1
# ============================================================
# django-whiteneuron base image — Debian (glibc; used by Sense "core" targets)
# Built from this repository by docker/build-base.sh or .github/workflows/docker-base.yml
# Published as: ${IMAGE_NAMESPACE}/django-whiteneuron-debian:${WHITENEURON_VERSION}
# ============================================================

ARG PYTHON_VERSION=3.13

FROM python:${PYTHON_VERSION}-slim-bookworm AS base

# vX.Y.Z.W — must match pyproject's version (checked below)
ARG WHITENEURON_VERSION

LABEL org.opencontainers.image.title="django-whiteneuron-debian" \
      org.opencontainers.image.source="https://github.com/White-Neuron/django-whiteneuron" \
      org.opencontainers.image.version="${WHITENEURON_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Ho_Chi_Minh

# The package is installed from the build context (bind mount: no source layer in the image)
RUN --mount=type=bind,target=/tmp/src,rw \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends ca-certificates && \
    pip install --no-cache-dir /tmp/src && \
    installed="v$(python -c 'import importlib.metadata as m; print(m.version("django-whiteneuron"))')" && \
    if [ -n "${WHITENEURON_VERSION}" ] && [ "${installed}" != "${WHITENEURON_VERSION}" ]; then \
        echo "WHITENEURON_VERSION=${WHITENEURON_VERSION} but the source is ${installed}" >&2; exit 1; \
    fi && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system appuser && \
    adduser --system --ingroup appuser --home /app appuser

USER appuser
