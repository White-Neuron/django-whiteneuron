# syntax=docker/dockerfile:1
# ============================================================
# django-whiteneuron base image — Debian (glibc; used by Sense "core" targets)
# Built by docker/build-base.sh (locally and in .github/workflows/docker-base.yml)
# Published as: ${IMAGE_NAMESPACE}/django-whiteneuron-debian:v<version>
# ============================================================

ARG PYTHON_VERSION=3.13

FROM python:${PYTHON_VERSION}-slim-bookworm AS base

# v<version> of the source being installed (checked below)
ARG WHITENEURON_VERSION
ARG DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="django-whiteneuron-debian" \
      org.opencontainers.image.source="https://github.com/White-Neuron/django-whiteneuron" \
      org.opencontainers.image.version="${WHITENEURON_VERSION}" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=Asia/Ho_Chi_Minh

# Dependencies pinned from uv.lock (docker-requirements.txt, written by build-base.sh), then
# the package itself from the build context (bind mount: no source layer in the image)
RUN --mount=type=bind,target=/tmp/src,rw \
    apt-get update && \
    apt-get upgrade -y && \
    pip install --no-cache-dir -r /tmp/src/docker-requirements.txt && \
    pip install --no-cache-dir --no-deps /tmp/src && \
    python -c 'import importlib.metadata as m, os, sys; from pip._vendor.packaging.version import Version as V; w = os.environ.get("WHITENEURON_VERSION", ""); i = m.version("django-whiteneuron"); sys.exit(f"WHITENEURON_VERSION={w} but the source is {i}" if w and V(w.lstrip("v")) != V(i) else 0)' && \
    rm -rf /var/lib/apt/lists/* && \
    addgroup --system --gid 101 appuser && \
    adduser --system --uid 100 --ingroup appuser --home /app appuser

# numeric, so runAsNonRoot can verify it (same ids as earlier releases: volumes stay writable)
USER 100:101
